# Production deployment environment variables for Hetzner server

# Ingress domain and TLS
API_DOMAIN=api.hittiguess.com
LETSENCRYPT_EMAIL=admin@hittiguess.com

# Core application settings
APP_ENV=prod
FRONTEND_URL=https://www.hittiguess.com
FRONTEND_ALLOWED_ORIGINS=https://www.hittiguess.com,https://hittiguess.com
COOKIE_DOMAIN=hittiguess.com
EMAIL_FROM_ADDRESS=noreply@hittiguess.com
MAX_ACTIVE_GAMES=50

# Core transactional database (Neon)
DB_URL=jdbc:postgresql://ep-silent-frost-b2i3fnwt.c-6.eu-central-1.aws.neon.tech:5432/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_core_password_here

# Analytics database (Neon)
ANALYTICS_DB_URL=jdbc:postgresql://ep-autumn-tooth-b1r5ao27.c-5.eu-central-1.aws.neon.tech:5432/neondb?sslmode=require
ANALYTICS_DB_USERNAME=neondb_owner
ANALYTICS_DB_PASSWORD=your_neon_analytics_password_here

# AI service database URL (pure Postgres URL for asyncpg / pg8000)
AI_DATABASE_URL=postgresql://neondb_owner:your_neon_core_password_here@ep-silent-frost-b2i3fnwt.c-6.eu-central-1.aws.neon.tech:5432/neondb?sslmode=require

# Authentication and inter-service security
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
INTERNAL_SERVICE_API_KEY=your_internal_service_api_key_here

# Google OAuth2 sign-in
OAUTH2_CLIENT_ID=your_google_oauth_client_id_here
OAUTH2_CLIENT_SECRET=your_google_oauth_client_secret_here

# Transactional email (Resend)
RESEND_API_KEY=your_resend_api_key_here

# Third-party metadata and LLM APIs
OPENAI_API_KEY=your_openai_api_key_here
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
YOUTUBE_API_KEY=your_restricted_youtube_api_key_here
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
WIKIDATA_BOT_USERNAME=
WIKIDATA_BOT_PASSWORD=
WIKIPEDIA_BOT_USERNAME=
WIKIPEDIA_BOT_PASSWORD=

# Observability (Sentry and Grafana Cloud OpenTelemetry)
SENTRY_DSN=your_sentry_dsn_here
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20your_otlp_base64_credentials_here

# WebRTC Voice and DJ audio TURN fallback (Cloudflare)
VOICE_TURN_CLOUDFLARE_KEY_ID=your_cloudflare_turn_key_id_here
VOICE_TURN_CLOUDFLARE_API_TOKEN=your_cloudflare_turn_api_token_here

# Metrics scraping and remote write (Grafana Alloy)
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-24-prod-eu-west-2.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USERNAME=your_grafana_prometheus_username_here
GRAFANA_CLOUD_PROMETHEUS_API_KEY=your_grafana_prometheus_api_key_here
