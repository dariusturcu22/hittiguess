# Copy to .env and fill in real values. .env is gitignored, never commit it.

OPENAI_API_KEY=
YOUTUBE_API_KEY=
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# Shared secret the core service sends on every request to this service.
# Must match the same value the core service is configured with.
INTERNAL_SERVICE_API_KEY=

OPENAI_MODEL=gpt-5.1

# DeepSeek-V4-Flash, hosted on DeepInfra: the Wikipedia-extraction model
# (story 20, story 18). DEEPINFRA_MODEL defaults to deepseek-ai/DeepSeek-V4-Flash.
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=

# Other candidates from story 20's local/cheap LLM spike, kept only for
# ai/spikes/ reference, none of these are called by the production
# microservice. llama.cpp needs no key, it runs locally.
ZHIPU_API_KEY=
GROQ_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Wikidata bot-password login (spikes/wikidata_spike.py), unlocks the 200/min
# authenticated tier instead of 10/min anonymous. See ai/spikes/README.md.
WIKIDATA_BOT_USERNAME=
WIKIDATA_BOT_PASSWORD=

# Wikipedia bot-password login (spikes/wikipedia_spike.py), separate from the
# Wikidata one above, bot passwords are issued per-wiki even though it's the
# same underlying Wikimedia account. See ai/spikes/README.md.
WIKIPEDIA_BOT_USERNAME=
WIKIPEDIA_BOT_PASSWORD=
