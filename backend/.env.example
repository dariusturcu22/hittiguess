# Copy to .env and fill in real values. .env is gitignored, never commit it.

# DB_NAME, DB_USERNAME, and DB_PASSWORD provision the local Postgres
# container (docker-compose.yml) and authenticate Spring Boot's
# connection to it (application.properties) -- same variables, both
# places. The database name in DB_URL should match DB_NAME when
# pointing at the local docker-compose Postgres (port 5500).
DB_NAME=hittiguess
DB_USERNAME=hittiguess
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5500/hittiguess

# ANALYTICS_DB_* provision the separate append-heavy Postgres instance for
# usage/event data (story 33), independent of the transactional database
# above. Same pairing convention: docker-compose.yml on port 5501, and
# application.properties reads the matching ANALYTICS_DB_URL.
ANALYTICS_DB_NAME=hittiguess_analytics
ANALYTICS_DB_USERNAME=hittiguess_analytics
ANALYTICS_DB_PASSWORD=
ANALYTICS_DB_URL=jdbc:postgresql://localhost:5501/hittiguess_analytics

JWT_SECRET=

# AI_SERVICE_URL points at the AI microservice (ai/); INTERNAL_SERVICE_API_KEY
# must match the same value the AI microservice is configured with.
AI_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_API_KEY=

OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

FRONTEND_URL=http://localhost:3000
APP_ENV=dev
