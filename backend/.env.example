# Copy to .env and fill in real values. .env is gitignored, never commit it.

# Used by docker-compose.yml to provision the local Postgres container.
DB_NAME=hitster
DB_USER=hitster
DB_PASSWORD=

# Used by Spring Boot (application.properties). DB_USERNAME and
# DB_PASSWORD should match DB_USER/DB_PASSWORD above, and the database
# name in DB_URL should match DB_NAME, when pointing at the local
# docker-compose Postgres (port 5500, see docker-compose.yml).
DB_URL=jdbc:postgresql://localhost:5500/hitster
DB_USERNAME=hitster
DB_PASSWORD=

JWT_SECRET=

OPENAI_API_KEY=
YOUTUBE_API_KEY=

OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

FRONTEND_URL=http://localhost:3000
APP_ENV=dev
