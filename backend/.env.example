# Copy to .env and fill in real values. .env is gitignored, never commit it.

# DB_NAME, DB_USERNAME, and DB_PASSWORD provision the local Postgres
# container (docker-compose.yml) and authenticate Spring Boot's
# connection to it (application.properties) -- same variables, both
# places. The database name in DB_URL should match DB_NAME when
# pointing at the local docker-compose Postgres (port 5500).
DB_NAME=hittiguess
DB_USERNAME=hittiguess
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5500/hittiguess

# ANALYTICS_DB_* provision the separate append-heavy Postgres instance for
# usage/event data (story 33), independent of the transactional database
# above. Same pairing convention: docker-compose.yml on port 5501, and
# application.properties reads the matching ANALYTICS_DB_URL.
ANALYTICS_DB_NAME=hittiguess_analytics
ANALYTICS_DB_USERNAME=hittiguess_analytics
ANALYTICS_DB_PASSWORD=
ANALYTICS_DB_URL=jdbc:postgresql://localhost:5501/hittiguess_analytics

JWT_SECRET=

# AI_SERVICE_URL points at the AI microservice (ai/); INTERNAL_SERVICE_API_KEY
# must match the same value the AI microservice is configured with.
AI_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_API_KEY=

OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

# Resend (transactional email, story 50): from the Resend dashboard's API Keys page.
# Verification and password-reset emails degrade to a log line carrying the same link a
# real email would, instead of failing registration or a reset request, until this is set.
# EMAIL_FROM_ADDRESS defaults to Resend's own shared testing sender, which works with no
# domain verification; a real deployment should replace it with a verified domain address.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins accepted by HTTP and WebSocket endpoints.
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,https://my-hitster.dariusturcu22.com
# Local-network playtest: set both values to this machine's LAN address
# (e.g. http://192.168.1.50:3000) so links resolve on other devices. With
# voice, use the HTTPS proxy's address (e.g. https://192.168.1.50:3443).
# See docs/DEV_SETUP.md.
APP_ENV=dev

# Sentry (error tracking): from the Sentry project's Settings > Client Keys (DSN).
# Inactive, a safe no-op, until SENTRY_DSN is set.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry (traces, and logs once Alloy ships them the same way): OTEL_SDK_DISABLED
# must be set to false, alongside both variables below, or tracing stays a
# local-only no-op. OTEL_EXPORTER_OTLP_ENDPOINT and OTEL_EXPORTER_OTLP_HEADERS
# are standard OpenTelemetry variables the SDK reads directly, not Spring
# properties. Endpoint is Grafana Cloud's unified OTLP gateway, which accepts
# metrics, logs, and traces alike. Headers authenticate against it:
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of "StackID:APIToken">.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Grafana Cloud Prometheus (metrics): from the stack's connection details page.
# Not consumed by the application directly, both services only expose a local
# scrape endpoint (/actuator/prometheus, /metrics); a Grafana Alloy container
# reads these variables to scrape and push metrics via Prometheus remote_write.
# Not wired in yet. Logs ship through the OTLP endpoint above instead of a
# separate Loki-specific push URL.
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USERNAME=
GRAFANA_CLOUD_PROMETHEUS_API_KEY=

# Voice chat (story 12): ICE servers for the WebRTC mesh. VOICE_TURN_STUN_URL has a
# working default (Cloudflare's public STUN) and rarely needs overriding. The Cloudflare
# TURN relay is a fallback for peers that can't connect directly; leave the two variables
# below blank until a Cloudflare Realtime TURN key is provisioned, and credentials come
# back STUN-only. Both must be set together to enable TURN. The API token is a secret,
# treat it like every other key here.
VOICE_TURN_STUN_URL=stun:stun.cloudflare.com:3478
VOICE_TURN_CLOUDFLARE_KEY_ID=
VOICE_TURN_CLOUDFLARE_API_TOKEN=
