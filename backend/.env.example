# Copy to .env and fill in real values. .env is gitignored, never commit it.

# DB_NAME, DB_USERNAME, and DB_PASSWORD provision the local Postgres
# container (docker-compose.yml) and authenticate Spring Boot's
# connection to it (application.properties) -- same variables, both
# places. The database name in DB_URL should match DB_NAME when
# pointing at the local docker-compose Postgres (port 5500).
DB_NAME=hittiguess
DB_USERNAME=hittiguess
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5500/hittiguess

JWT_SECRET=

# AI_SERVICE_URL points at the AI microservice (ai/); INTERNAL_SERVICE_API_KEY
# must match the same value the AI microservice is configured with.
AI_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_API_KEY=

OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

FRONTEND_URL=http://localhost:3000
APP_ENV=dev

# Sentry (error tracking): from the Sentry project's Settings > Client Keys (DSN).
# Inactive, a safe no-op, until SENTRY_DSN is set.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry (traces, viewed in Grafana Cloud's Tempo): OTEL_SDK_DISABLED must
# be set to false, alongside both variables below, or tracing stays a local-only
# no-op. OTEL_EXPORTER_OTLP_ENDPOINT and OTEL_EXPORTER_OTLP_HEADERS are standard
# OpenTelemetry variables the SDK reads directly, not Spring properties.
# Endpoint is the Tempo OTLP URL from the Grafana Cloud stack's connection details.
# Headers authenticate against it: OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic
# <base64 of "InstanceID:APIToken">.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Grafana Cloud Prometheus and Loki (metrics and logs): from the stack's
# connection details pages. Not consumed by the application directly, both
# services only expose a local scrape endpoint (/actuator/prometheus, /metrics)
# and stdout logs; a Grafana Alloy container reads these variables to scrape
# and ship both to Grafana Cloud. Not wired in yet, held here so every
# credential lands in one place once it is.
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USERNAME=
GRAFANA_CLOUD_PROMETHEUS_API_KEY=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USERNAME=
GRAFANA_CLOUD_LOKI_API_KEY=
