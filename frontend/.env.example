# Copy to .env.local and fill in real values. .env* is gitignored, never commit it.

NEXT_PUBLIC_API_URL=http://localhost:8080
# Local-network playtest: set this to the host machine's LAN address (e.g.
# http://192.168.1.50:8080). The value embeds at build time, so restart the
# dev server or rebuild after changing it. With voice, use the HTTPS proxy's
# address instead (e.g. https://192.168.1.50:3443). See docs/DEV_SETUP.md.

# Closed-beta showcase. With the flag on, only the landing page and /closed-beta
# are reachable without the access cookie, and the landing page makes no API calls.
# The password is server-only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_CLOSED_BETA=false
BETA_ACCESS_PASSWORD=
