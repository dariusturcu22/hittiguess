# Copy to .env.local and fill in real values. .env* is gitignored, never commit it.

NEXT_PUBLIC_API_URL=http://localhost:8080
# LAN playtest: point this at the owner's LAN IP (e.g.
# http://192.168.1.50:8080) so mates' browsers call this machine instead of
# their own localhost. This value inlines into the client bundle at build
# time, so set it before starting the dev server or rebuilding. Every API
# and WebSocket URL derives from it. See docs/DEV_SETUP.md's LAN playtest
# section.
